;/*++
;
;Copyright (c) Microsoft Corporation All rights Reserved
;
;Module Name:
;
;    vihidmini.inf
;
;Abstract:
;    INF file for installing HID minidriver (KMDF version)
;
;Installation Notes:
;    Requires a real ACPI\LGSW4290 device and a working I2C SPB host.
;
;--*/
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderString%
DriverVer=10/19/2026,0.2.1.0
CatalogFile=sw42902.cat
PnpLockDown = 1

; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=Microsoft,NT$ARCH$.10.0...22000

; Windows 11 provides the MsHidKmdf.inf inbox installation contract.
[Microsoft.NT$ARCH$.10.0...22000]
%DeviceDesc%=vhidmini, ACPI\LGSW4290

[vhidmini.NT]
CopyFiles=KMDriverCopy
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT

[vhidmini.NT.hw]
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.HW

[vhidmini.NT.Services]
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.Services
AddService=vhidmini,0,vhidmini_Service_Inst

[vhidmini.NT.Filters]
AddFilter=vhidmini,,vhidmini_Filter_Install


[vhidmini_Filter_Install]
FilterPosition=Lower

[vhidmini_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\vhidmini.sys

[vhidmini.NT.Wdf]
KmdfService=vhidmini, vhidmini_wdfsect

[vhidmini_wdfsect]
KmdfLibraryVersion=$KMDFVERSION$

; ================= copy files =====================

[KMDriverCopy]
vhidmini.sys

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
vhidmini.sys=1

[DestinationDirs]
KMDriverCopy=13

;---------------------------------------------------------------;

[Strings]
ProviderString     = "LG timelm experimental port"
ManufacturerString = "LG timelm bring-up"
DeviceDesc         = "LGSIC SW42902 Touch"
ServiceDesc        = "LGSIC SW42902 Touchscreen Controller Service"
DiskDesc           = "LGSIC SW42902 Touchscreen Controller Installation Disk"
