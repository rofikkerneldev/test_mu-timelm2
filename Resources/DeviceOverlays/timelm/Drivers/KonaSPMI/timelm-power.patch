+// Persist probe results even when PrepareHardware fails. No power register writes.
+static VOID PMICRecordProbe(WDFDEVICE Device, UINT8 Sid, NTSTATUS Status, UINT8 Model)
+{
+    WDFKEY key;
+    UNICODE_STRING name;
+    WCHAR statusName[] = L"TimelmProbeStatusSID00";
+    WCHAR modelName[] = L"TimelmProbeModelSID00";
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    if (!NT_SUCCESS(WdfDeviceOpenRegistryKey(Device, PLUGPLAY_REGKEY_DEVICE,
+        KEY_SET_VALUE, WDF_NO_OBJECT_ATTRIBUTES, &key))) return;
+    RtlInitUnicodeString(&name, L"TimelmProbeLastSID");
+    (VOID)WdfRegistryAssignULong(key, &name, Sid);
+    RtlInitUnicodeString(&name, L"TimelmProbeLastStatus");
+    (VOID)WdfRegistryAssignULong(key, &name, (ULONG)Status);
+    if (Sid < 16) {
+        statusName[RTL_NUMBER_OF(statusName)-3] = hex[Sid >> 4];
+        statusName[RTL_NUMBER_OF(statusName)-2] = hex[Sid & 15];
+        modelName[RTL_NUMBER_OF(modelName)-3] = hex[Sid >> 4];
+        modelName[RTL_NUMBER_OF(modelName)-2] = hex[Sid & 15];
+        RtlInitUnicodeString(&name, statusName);
+        (VOID)WdfRegistryAssignULong(key, &name, (ULONG)Status);
+        RtlInitUnicodeString(&name, modelName);
+        (VOID)WdfRegistryAssignULong(key, &name, Model);
+    }
+    WdfRegistryClose(key);
+}
+
+static BOOLEAN PMICNextArgument(PACPI_METHOD_ARGUMENT Arg, UINT8* End, PACPI_METHOD_ARGUMENT* Next)
+{
+    ULONG_PTR remaining;
+    ULONG span;
+    if ((ULONG_PTR)Arg > (ULONG_PTR)End) return FALSE;
+    remaining = (ULONG_PTR)End - (ULONG_PTR)Arg;
+    if (remaining < sizeof(ACPI_METHOD_ARGUMENT)) return FALSE;
+    span = FIELD_OFFSET(ACPI_METHOD_ARGUMENT, Data) + max((ULONG)Arg->DataLength, sizeof(ULONG));
+    if (span > remaining) return FALSE;
+    *Next = (PACPI_METHOD_ARGUMENT)((UINT8*)Arg + span);
+    return TRUE;
+}
 
