+/* Device-lifetime query interfaces. Registration survives hardware stop /
+ * release; successful entries must not be added again on the same WDFDEVICE.
+ * Track each success so a partial allocation failure can retry the remainder. */
+NTSTATUS GPIOTouchRegisterInterfaces(WDFDEVICE Device, PGPIO_DEVICE_CONTEXT gpioContext)
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    {
+        TLMM_INTERFACE tlmmInterface;
+        WDF_QUERY_INTERFACE_CONFIG queryInterfaceConfig;
+        RtlZeroMemory(&tlmmInterface, sizeof(TLMM_INTERFACE));
+
+        tlmmInterface.Interface.Size = sizeof(TLMM_INTERFACE);
+        tlmmInterface.Interface.Version = 1;
+        tlmmInterface.Interface.Context = (PVOID)gpioContext;
+
+        tlmmInterface.Interface.InterfaceReference = WdfDeviceInterfaceReferenceNoOp;
+        tlmmInterface.Interface.InterfaceDereference = WdfDeviceInterfaceDereferenceNoOp;
+
+        tlmmInterface.ConfigurePinMux = GPIOConfigurePinMux;
+        if (!(gpioContext->TouchInterfacesAdded & 1u)) {
+            TIMELM_TOUCH_BUS touch;
+            WDF_QUERY_INTERFACE_CONFIG query;
+            RtlZeroMemory(&touch, sizeof(touch));
+            touch.Interface.Size = sizeof(touch);
+            touch.Interface.Version = 2;
+            touch.Interface.Context = gpioContext;
+            touch.Interface.InterfaceReference = WdfDeviceInterfaceReferenceNoOp;
+            touch.Interface.InterfaceDereference = WdfDeviceInterfaceDereferenceNoOp;
+            touch.SetBus = GPIOTouchBus;
+            WDF_QUERY_INTERFACE_CONFIG_INIT(&query, (PINTERFACE)&touch,
+                &GUID_TIMELM_TOUCH_BUS, NULL);
+            status = WdfDeviceAddQueryInterface(Device, &query);
+            if (!NT_SUCCESS(status)) goto Exit;
+            gpioContext->TouchInterfacesAdded |= 1u;
+        }
+        if (!(gpioContext->TouchInterfacesAdded & 2u)) {
+            TIMELM_TOUCH_BUS_V3 touch;
+            WDF_QUERY_INTERFACE_CONFIG query;
+            RtlZeroMemory(&touch, sizeof(touch));
+            touch.Interface.Size = sizeof(touch);
+            touch.Interface.Version = 3;
+            touch.Interface.Context = gpioContext;
+            touch.Interface.InterfaceReference = GPIOTouchReference;
+            touch.Interface.InterfaceDereference = GPIOTouchDereference;
+            touch.SetGpioMode = GPIOTouchGpioMode;
+            touch.SetLines = GPIOTouchSetLines;
+            touch.GetLines = GPIOTouchGetLines;
+            WDF_QUERY_INTERFACE_CONFIG_INIT(&query, (PINTERFACE)&touch,
+                &GUID_TIMELM_TOUCH_BUS_V3, NULL);
+            status = WdfDeviceAddQueryInterface(Device, &query);
+            if (!NT_SUCCESS(status)) goto Exit;
+            gpioContext->TouchInterfacesAdded |= 2u;
+        }
+
+        if (!(gpioContext->TouchInterfacesAdded & 8u)) {
+            TIMELM_TOUCH_BUS_V4 touch;
+            WDF_QUERY_INTERFACE_CONFIG query;
+            RtlZeroMemory(&touch, sizeof(touch));
+            touch.Interface.Size = sizeof(touch);
+            touch.Interface.Version = 4;
+            touch.Interface.Context = gpioContext;
+            touch.Interface.InterfaceReference = GPIOTouchReference;
+            touch.Interface.InterfaceDereference = GPIOTouchDereference;
+            touch.SetGpioMode = GPIOTouchGpioMode;
+            touch.SetLines = GPIOTouchSetLines;
+            touch.GetLines = GPIOTouchGetLines;
+            touch.QueryState = GPIOTouchQueryState;
+            WDF_QUERY_INTERFACE_CONFIG_INIT(&query, (PINTERFACE)&touch,
+                &GUID_TIMELM_TOUCH_BUS_V4, NULL);
+            status = WdfDeviceAddQueryInterface(Device, &query);
+            if (!NT_SUCCESS(status)) goto Exit;
+            gpioContext->TouchInterfacesAdded |= 8u;
+        }
+        if (!(gpioContext->TouchInterfacesAdded & 4u)) {
+            WDF_QUERY_INTERFACE_CONFIG_INIT(
+                &queryInterfaceConfig,
+                (PINTERFACE)&tlmmInterface,
+                &GUID_TLMM_INTERFACE,
+                NULL
+            );
+
+            status = WdfDeviceAddQueryInterface(
+                Device,
+                &queryInterfaceConfig
+            );
+
+            if (!NT_SUCCESS(status))
+            {
+                TraceEvents(TRACE_LEVEL_ERROR, TRACE_DRIVER, "Failed to add interface");
+                goto Exit;
+            }
+            gpioContext->TouchInterfacesAdded |= 4u;
+        }
+    }
+
+Exit:
+    return status;
+}
+
+/* Private fixed-pin open-drain interface. The caller holds both exclusive
+ * Resource Hub input connections. No clock, GENI or SMMU register is touched.
+ * A spin lock protects one callback, never a complete I2C transfer/delay. */
+VOID GPIOTouchReference(PVOID Context)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    WdfObjectReference(context->TouchDevice);
+}
+VOID GPIOTouchDereference(PVOID Context)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    WdfObjectDereference(context->TouchDevice);
+}
+static BOOLEAN TouchGpioReady(PGPIO_DEVICE_CONTEXT context)
+{
+    return context && context->TouchGpioLockReady && context->Base &&
+        context->Length >= SOUTH + IO_REG(37) + sizeof(ULONG);
+}
+static NTSTATUS TouchGpioLine(PGPIO_DEVICE_CONTEXT context, ULONG pin, BOOLEAN release)
+{
+    PULONG ctl = (PULONG)(context->Base + SOUTH + CTL_REG(pin));
+    PULONG io = (PULONG)(context->Base + SOUTH + IO_REG(pin));
+    ULONG value = Read32(ctl), latch = Read32(io);
+    if (value == 0xffffffffu || latch == 0xffffffffu || (value & MUX_MASK))
+        return STATUS_IO_DEVICE_ERROR;
+    /* Begin already cleared the latch with OE disabled. Never release an
+     * already-low SCL just to clear its latch again: that creates a clock. */
+    if (latch & BIT(OUT_BIT)) return STATUS_IO_DEVICE_ERROR;
+    value = KonaGpioOpenDrainValue(value, release);
+    Write32(ctl, value);
+    return ((Read32(ctl) ^ value) & 0x3ffu) ? STATUS_IO_DEVICE_ERROR : STATUS_SUCCESS;
+}
+NTSTATUS GPIOTouchQueryState(PVOID Context, ULONG *Gate, ULONGLONG *Generation)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    KIRQL oldIrql;
+    NTSTATUS status = STATUS_SUCCESS;
+    if (!Gate || !Generation) return STATUS_INVALID_PARAMETER;
+    *Gate = 0; *Generation = 0;
+    if (!TouchGpioReady(context)) return STATUS_DEVICE_NOT_READY;
+    KeAcquireSpinLock(&context->TouchGpioLock, &oldIrql);
+    if (!TouchGpioReady(context)) status = STATUS_DEVICE_NOT_READY;
+    else {
+        *Gate = context->TouchGpioEnabled ? 1u : 0u;
+        *Generation = context->TouchGeneration;
+    }
+    KeReleaseSpinLock(&context->TouchGpioLock, oldIrql);
+    return status;
+}
+NTSTATUS GPIOTouchGpioMode(PVOID Context, BOOLEAN Enable)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    KIRQL oldIrql;
+    NTSTATUS status = STATUS_SUCCESS;
+    ULONG i;
+    if (!TouchGpioReady(context)) return STATUS_DEVICE_NOT_READY;
+    KeAcquireSpinLock(&context->TouchGpioLock, &oldIrql);
+    if (!TouchGpioReady(context)) { status = STATUS_DEVICE_NOT_READY; goto Done; }
+    if (Enable) {
+        if (!context->TouchGpioEnabled) { status = STATUS_NOT_SUPPORTED; goto Done; }
+        if (context->TouchPinsConnected != 3) { status = STATUS_DEVICE_NOT_READY; goto Done; }
+        if (InterlockedCompareExchange(&context->TouchBusActive, -1, 0) != 0) {
+            status = STATUS_DEVICE_BUSY; goto Done;
+        }
+        for (i = 0; i < 2; ++i) {
+            ULONG ctl = Read32((PULONG)(context->Base + SOUTH + CTL_REG(36 + i)));
+            ULONG io = Read32((PULONG)(context->Base + SOUTH + IO_REG(36 + i)));
+            /* The only accepted prior functions are GPIO and QUP13. Restore
+             * must never reinstate a push-pull-high GPIO output. */
+            if (ctl == 0xffffffffu || io == 0xffffffffu ||
+                (ctl & MUX_MASK) > 4u || ((ctl & BIT(OE_BIT)) && (io & BIT(OUT_BIT)))) {
+                InterlockedExchange(&context->TouchBusActive, 0);
+                status = STATUS_DEVICE_CONFIGURATION_ERROR; goto Done;
+            }
+            context->TouchGpioSavedCtl[i] = ctl;
+            context->TouchGpioSavedIo[i] = io;
+        }
+        /* Ownership remains on any partial-write failure: End can restore. */
+        InterlockedExchange(&context->TouchBusActive, 2);
+        for (i = 0; i < 2; ++i) {
+            PULONG ctl = (PULONG)(context->Base + SOUTH + CTL_REG(36 + i));
+            PULONG io = (PULONG)(context->Base + SOUTH + IO_REG(36 + i));
+            Write32(ctl, context->TouchGpioSavedCtl[i] & ~BIT(OE_BIT));
+            if (Read32(ctl) & BIT(OE_BIT)) { status = STATUS_IO_DEVICE_ERROR; goto Done; }
+            Write32(io, KonaGpioLowLatchValue(Read32(io)));
+            if (Read32(io) & BIT(OUT_BIT)) { status = STATUS_IO_DEVICE_ERROR; goto Done; }
+            Write32(ctl, KonaGpioOpenDrainValue(context->TouchGpioSavedCtl[i], 1));
+            if (Read32(ctl) & 0x3ffu) { status = STATUS_IO_DEVICE_ERROR; goto Done; }
+        }
+    } else {
+        if (context->TouchBusActive == 0) goto Done;
+        if (context->TouchBusActive != 2) { status = STATUS_DEVICE_BUSY; goto Done; }
+        /* Release both pins before restoring any saved latches/mux fields. */
+        for (i = 0; i < 2; ++i) {
+            PULONG ctl = (PULONG)(context->Base + SOUTH + CTL_REG(36 + i));
+            Write32(ctl, Read32(ctl) & ~BIT(OE_BIT));
+            if (Read32(ctl) & BIT(OE_BIT)) { status = STATUS_IO_DEVICE_ERROR; goto Done; }
+        }
+        for (i = 0; i < 2; ++i) {
+            PULONG ctl = (PULONG)(context->Base + SOUTH + CTL_REG(36 + i));
+            PULONG io = (PULONG)(context->Base + SOUTH + IO_REG(36 + i));
+            ULONG value = KonaGpioRestoreValue(Read32(ctl), context->TouchGpioSavedCtl[i]);
+            Write32(io, (Read32(io) & ~BIT(OUT_BIT)) | (context->TouchGpioSavedIo[i] & BIT(OUT_BIT)));
+            Write32(ctl, value);
+            if (((Read32(ctl) ^ value) & 0x3ffu) ||
+                ((Read32(io) ^ context->TouchGpioSavedIo[i]) & BIT(OUT_BIT))) {
+                status = STATUS_IO_DEVICE_ERROR; goto Done;
+            }
+        }
+        InterlockedExchange(&context->TouchBusActive, 0);
+    }
+Done:
+    KeReleaseSpinLock(&context->TouchGpioLock, oldIrql);
+    return status;
+}
+NTSTATUS GPIOTouchSetLines(PVOID Context, BOOLEAN ReleaseScl, BOOLEAN ReleaseSda)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    KIRQL oldIrql;
+    NTSTATUS status;
+    if (!TouchGpioReady(context)) return STATUS_DEVICE_NOT_READY;
+    KeAcquireSpinLock(&context->TouchGpioLock, &oldIrql);
+    if (!TouchGpioReady(context) || context->TouchBusActive != 2) {
+        status = STATUS_DEVICE_NOT_READY; goto Done;
+    }
+    /* Pull SCL low before changing data; set data before releasing SCL high. */
+    status = TouchGpioLine(context, ReleaseScl ? 36u : 37u,
+                          ReleaseScl ? ReleaseSda : FALSE);
+    if (NT_SUCCESS(status))
+        status = TouchGpioLine(context, ReleaseScl ? 37u : 36u,
+                              ReleaseScl ? TRUE : ReleaseSda);
+Done:
+    KeReleaseSpinLock(&context->TouchGpioLock, oldIrql);
+    return status;
+}
+NTSTATUS GPIOTouchGetLines(PVOID Context, PBOOLEAN SclHigh, PBOOLEAN SdaHigh)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    KIRQL oldIrql;
+    NTSTATUS status = STATUS_SUCCESS;
+    ULONG scl, sda;
+    if (!SclHigh || !SdaHigh) return STATUS_INVALID_PARAMETER;
+    *SclHigh = *SdaHigh = FALSE;
+    if (!TouchGpioReady(context)) return STATUS_DEVICE_NOT_READY;
+    KeAcquireSpinLock(&context->TouchGpioLock, &oldIrql);
+    if (!TouchGpioReady(context) || context->TouchBusActive != 2) {
+        status = STATUS_DEVICE_NOT_READY; goto Done;
+    }
+    scl = Read32((PULONG)(context->Base + SOUTH + IO_REG(37)));
+    sda = Read32((PULONG)(context->Base + SOUTH + IO_REG(36)));
+    if (scl == 0xffffffffu || sda == 0xffffffffu) {
+        status = STATUS_IO_DEVICE_ERROR; goto Done;
+    }
+    *SclHigh = (scl & BIT(IN_BIT)) != 0;
+    *SdaHigh = (sda & BIT(IN_BIT)) != 0;
+Done:
+    KeReleaseSpinLock(&context->TouchGpioLock, oldIrql);
+    return status;
+}
+
+// Both pins are exclusively reserved by the SPB client's GPIO connections.
+NTSTATUS GPIOTouchBus(PVOID Context, BOOLEAN Enable)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    ULONG i;
+    KIRQL oldIrql;
+    NTSTATUS status = STATUS_SUCCESS;
+    if (!TouchGpioReady(context)) return STATUS_DEVICE_NOT_READY;
+    KeAcquireSpinLock(&context->TouchGpioLock, &oldIrql);
+    if (!TouchGpioReady(context)) { status = STATUS_DEVICE_NOT_READY; goto Done; }
+    if (InterlockedCompareExchange(&context->TouchBusActive, -1, Enable ? 0 : 1) != (Enable ? 0 : 1)) {
+        status = (!Enable && context->TouchBusActive == 0) ? STATUS_SUCCESS : STATUS_DEVICE_BUSY;
+        goto Done;
+    }
+    for (i = 0; i < 2; ++i) {
+        PULONG address = (PULONG)(context->Base + SOUTH + CTL_REG(36 + i));
+        ULONG value = Read32(address);
+        if (Enable) context->TouchBusSaved[i] = value;
+        // pull=none, mux=qup13(1), drive=2mA(0), OE=0. Preserve upper bits.
+        Write32(address, (value & ~0x3ffu) | (Enable ? 4u : (context->TouchBusSaved[i] & 0x3ffu)));
+    }
+    for (i = 0; i < 2; ++i) {
+        ULONG value = Read32((PULONG)(context->Base + SOUTH + CTL_REG(36 + i)));
+        if ((value & 0x3ffu) != (Enable ? 4u : (context->TouchBusSaved[i] & 0x3ffu))) {
+            // Keep the saved state and permit the owner to retry disable.
+            InterlockedExchange(&context->TouchBusActive, 1);
+            status = STATUS_IO_DEVICE_ERROR;
+            goto Done;
+        }
+    }
+    InterlockedExchange(&context->TouchBusActive, Enable ? 1 : 0);
+Done:
+    KeReleaseSpinLock(&context->TouchGpioLock, oldIrql);
+    return status;
+}
+/* End fixed touch bus callbacks. */
