+// Both pins are exclusively reserved by the SPB client's GPIO connections.
+NTSTATUS GPIOTouchBus(PVOID Context, BOOLEAN Enable)
+{
+    PGPIO_DEVICE_CONTEXT context = Context;
+    ULONG i;
+    if (!context->Base || context->Length < SOUTH + CTL_REG(37) + sizeof(ULONG))
+        return STATUS_DEVICE_NOT_READY;
+    if (InterlockedCompareExchange(&context->TouchBusActive, -1, Enable ? 0 : 1) != (Enable ? 0 : 1))
+        return (!Enable && context->TouchBusActive == 0) ? STATUS_SUCCESS : STATUS_DEVICE_BUSY;
+    for (i = 0; i < 2; ++i) {
+        PULONG address = (PULONG)(context->Base + SOUTH + CTL_REG(36 + i));
+        ULONG value = Read32(address);
+        if (Enable) context->TouchBusSaved[i] = value;
+        // pull=none, mux=qup13(1), drive=2mA(0), OE=0. Preserve upper bits.
+        Write32(address, (value & ~0x3ffu) | (Enable ? 4u : (context->TouchBusSaved[i] & 0x3ffu)));
+    }
+    for (i = 0; i < 2; ++i) {
+        ULONG value = Read32((PULONG)(context->Base + SOUTH + CTL_REG(36 + i)));
+        if ((value & 0x3ffu) != (Enable ? 4u : (context->TouchBusSaved[i] & 0x3ffu))) {
+            // Keep the saved state and permit the owner to retry disable.
+            InterlockedExchange(&context->TouchBusActive, 1);
+            return STATUS_IO_DEVICE_ERROR;
+        }
+    }
+    InterlockedExchange(&context->TouchBusActive, Enable ? 1 : 0);
+    return STATUS_SUCCESS;
+}
